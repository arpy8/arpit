function Ensure-InPath {
    param (
        [string]$Directory
    )
    
    $currentPath = [Environment]::GetEnvironmentVariable("Path", "User")
    if (-not $currentPath.Contains($Directory)) {
        $newPath = "$Directory;$currentPath"
        [Environment]::SetEnvironmentVariable("Path", $newPath, "User")
        $env:Path = "$Directory;$env:Path"
    }
}

function Test-Command {
    param (
        [string]$Command
    )
    
    return (Get-Command $Command -ErrorAction SilentlyContinue) -ne $null
}

Write-Host "Starting arpit installation..."

# Check if Python is installed
if (-not (Test-Command "python") -and -not (Test-Command "python3")) {
    Write-Host "Python not found. Installing Python..."
    
    # Download Python installer
    $pythonUrl = "https://www.python.org/ftp/python/3.11.4/python-3.11.4-amd64.exe"
    $pythonInstaller = "$env:TEMP\python-installer.exe"
    
    try {
        Write-Host "Downloading Python installer..."
        Invoke-WebRequest -Uri $pythonUrl -OutFile $pythonInstaller
        
        Write-Host "Installing Python... This may take a few minutes."
        Start-Process -FilePath $pythonInstaller -ArgumentList "/quiet", "InstallAllUsers=0", "PrependPath=1" -Wait
        
        # Refresh environment variables
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
    }
    catch {
        Write-Host "Failed to install Python automatically. Please install Python from https://www.python.org/downloads/"
        Write-Host "Make sure to check 'Add Python to PATH' during installation."
        exit 1
    }
    finally {
        if (Test-Path $pythonInstaller) {
            Remove-Item $pythonInstaller
        }
    }
}

# Determine Python command (python or python3)
$pythonCmd = "python"
if (Test-Command "python3") {
    $pythonCmd = "python3"
}

# Get Python user base directory
$pythonUserBase = & $pythonCmd -m site --user-base
$pythonScriptsDir = Join-Path -Path $pythonUserBase -ChildPath "Scripts"

# Ensure Python scripts directory is in PATH
Ensure-InPath -Directory $pythonScriptsDir

# Install pip if not available
if (-not (Test-Command "pip") -and -not (Test-Command "pip3")) {
    Write-Host "Installing pip..."
    & $pythonCmd -m ensurepip --upgrade
}

# Determine pip command (pip or pip3)
$pipCmd = "pip"
if (Test-Command "pip3") {
    $pipCmd = "pip3"
}

# Install arpit package
Write-Host "Installing arpit package..."
& $pipCmd install --user git+https://gitlab.com/arpy8/arpit

# Check if arpit is installed and executable
$arpitPath = Join-Path -Path $pythonScriptsDir -ChildPath "arpit.exe"

if (-not (Test-Command "arpit") -and -not (Test-Path $arpitPath)) {
    Write-Host "Error: arpit was not installed correctly."
    exit 1
}
elseif (-not (Test-Command "arpit")) {
    Write-Host "Found arpit at $arpitPath"
    Ensure-InPath -Directory $pythonScriptsDir
}

# Run arpit
Write-Host "Running arpit..."
try {
    & arpit
}
catch {
    Write-Host "Error: Failed to run 'arpit'. Trying with full path..."
    & $arpitPath
}

Write-Host "Installation complete!"
